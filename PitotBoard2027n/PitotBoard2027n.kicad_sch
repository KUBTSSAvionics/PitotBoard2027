	(text "AS5600 3.3 V mode: VDD5V and VDD3V3 are tied together.\nGND1/GND2 remain local returns for separate sensor-board sections; do not short by PCB edit."
		(exclude_from_sim no)
		(at 304.8 185.42 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "15bf029b-e575-57b5-b3e7-d92a131561fd")
	)
	(text "SCL0/SDA0: native 3.3 V; obsolete FXMA2102 level shifter removed."
		(exclude_from_sim no)
		(at 402.59 78.74 0)
		(effects
