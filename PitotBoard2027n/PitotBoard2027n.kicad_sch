	)
	(text "VIN: protected/switched 1S LiPo (3.0-4.2V). VOUT nominal 3.45V (3.3V class).\nPS/SYNC=VIN; FB 1.18M / 200k, both 0.1%, <=25ppm/K.\nVerify 3.30-3.60V at loads including transients. No 4.75V-minimum regulator."
		(exclude_from_sim no)
		(at 40.64 107.95 0)
		(effects
			(font
				(size 0.95 0.95)
			)
			(justify left)
		)
		(uuid "833be2ae-e6f1-5edd-8dec-834c9b32ba5d")
	)
	(text "R24-R27 are fitted 4.7 kOhm pull-ups for the separate 3.3 V sensor-board I2C buses."
