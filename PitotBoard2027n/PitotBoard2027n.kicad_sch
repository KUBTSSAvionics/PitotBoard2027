	)
	(text "2027 CAN: 500 kbps / MCP2515=3.3 V / TCAN332DR=3.3 V\nY3=ECS-160-10-33-AGN-TR 16 MHz quartz; C23/C24=15 pF C0G\nJP1 open=no termination, closed=120 ohm termination"
		(exclude_from_sim no)
		(at 464.82 142.24 0)
		(effects
			(font
